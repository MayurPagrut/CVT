# HuggingFace API Key
# Get yours at: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here

# Optional overrides
# Default base URL is the OpenAI-compatible Inference Providers router.
# HF_BASE_URL=https://router.huggingface.co/v1
# Model ID to use for chat completions.
# Tip: you can try adding a policy suffix like :fastest (e.g. deepseek-ai/DeepSeek-R1:fastest)
# HF_MODEL=google/gemma-3-27b-it

# Emotion detection (backend)
# If not set, the backend auto-detects: emotion-chatbot/AI_companion_final/emotion4.h5
# EMOTION_MODEL_PATH=C:\ReactProject\CVT3\emotion-chatbot\AI_companion_final\emotion4.h5

# Set true to return simulated/random emotions (dev only).
# EMOTION_SIMULATION=false

# By default, the backend returns neutral when no face is detected.
# Set to false to allow running ML inference on the full frame (may look random on backgrounds).
# EMOTION_FACE_REQUIRED=true

# Heuristic adjustments ported from AI_companion_final/app.py
# EMOTION_HEURISTICS=true
